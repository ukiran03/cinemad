package pages

import (
	"ukiran03.com/cinemad/cmd/web/ui/html/layouts"
	"ukiran03.com/cinemad/internal/models"
)

templ PaymentSucceededPage(data models.TemplateData) {
	@layouts.Base(
		"Payment Succeeded!",
		data,
		paymentSucceededPageContent(data.Data),
	)
}

templ paymentSucceededPageContent(dataMap map[string]interface{}) {
	{{
		pi := dataMap["pi"].(string)
		cardholder := dataMap["cardholder"].(string)
		email := dataMap["email"].(string)
		pm := dataMap["pm"].(string)
		pa := dataMap["pa"].(string)
		pc := dataMap["pc"].(string)
	}}
	<h2 class="mt-5">Payment Succeeded</h2>
	<hr/>
	<p>Payment Intent: { pi }</p>
	<p>Cardholder: { cardholder }</p>
	<p>Email: { email }</p>
	<p>Payment Method: { pm }</p>
	<p>Payment Amount: { pa }</p>
	<p>Payment Currency: { pc }</p>
}
