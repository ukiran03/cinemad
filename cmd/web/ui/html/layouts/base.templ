package layouts

import "ukiran03.com/cinemad/internal/models"

templ Base(title string, data models.TemplateData, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/main.css"/>
			<link rel="shortcut icon" href="/static/img/favicon.png" type="image/x-icon"/>
		</head>
		<body>
			<header>
				<h1><a href="/">Cinemad</a></h1>
			</header>
			<main>
				if data.Flash != "" {
					<div class="flash">{ data.Flash }</div>
				}
				@content
			</main>
			<script src="/static/js/main.js" type="text/javascript"></script>
		</body>
	</html>
}
